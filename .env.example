# Copy to .env and fill in the blanks.
PORT=3002
BASE_PATH=/adventure       # served under a subpath on the shared Funnel hostname
NEXT_PUBLIC_BASE_PATH=/adventure  # same value, inlined into client code
DATABASE_URL=postgresql://user@localhost:5432/adventure_book
SESSION_SECRET=            # long random string, e.g. `openssl rand -hex 32`
UPLOAD_DIR=                # persistent media folder, e.g. this repo's ./uploads (gitignored; back it up)
DEFAULT_SLUG=our-story
NEXT_PUBLIC_STADIA_API_KEY= # optional; domain-restricted Stadia key for watercolor tiles on the public host (empty = plain OSM tiles fallback)
